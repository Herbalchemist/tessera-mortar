# The live system on a Tessera USB: Tessera itself, made bootable from the USB, starting into the
# Install Tessera screens. Built by .github/workflows/build-live.yml; see docs/plan.md.
#   podman build --cap-add sys_admin --security-opt label=disable -t tessera-live live/
ARG BASE_IMAGE=ghcr.io/herbalchemist/tessera:latest
FROM ${BASE_IMAGE}
COPY src /src
RUN --mount=type=cache,target=/var/tmp/libdnf5,id=libdnf5 /src/build.sh && rm -rf /src
