#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Live USB, only with "tessera.debug" on the kernel command line: every 45 seconds, copies the recent
# system log and Tessera's session log to the serial console, for testing in virtual machines.
# With "tessera.recovertest" instead: once, runs live-recover's look-only commands (probe, diagnose)
# and writes what they found to the serial console, for the install test (tools/install-test.sh).
if grep -qw 'tessera.recovertest' /proc/cmdline; then
  sleep 40
  out=/dev/ttyS0; [ -w "$out" ] || out=/dev/console
  {
    echo "tessera-recovertest: begin"
    /usr/libexec/tessera/live-recover probe
    for id in $(/usr/libexec/tessera/live-recover probe | python3 -c 'import json,sys; [print(i["id"]) for i in json.load(sys.stdin).get("installs", [])]'); do
      echo "-- diagnose $id"; /usr/libexec/tessera/live-recover diagnose "$id"
    done
    echo "-- layout"; for m in /run/tessera-recover/*/; do echo "$m: $(ls "$m" | tr '\n' ' ')"; command -v btrfs >/dev/null && btrfs subvolume list "$m" 2>/dev/null | head -20; done
    for j in /run/tessera-recover/*/var/log/journal /run/tessera-recover/*/root/ostree/deploy/*/var/log/journal /run/tessera-recover/*/ostree/deploy/*/var/log/journal; do [ -d "$j" ] && echo "journal: $j $(ls "$j" | head -3 | tr '\n' ' ')"; done
    for h in /run/tessera-recover/*/home /run/tessera-recover/*/var/home /run/tessera-recover/*/root/ostree/deploy/*/var/home; do [ -d "$h" ] && echo "homes: $h $(ls "$h" | tr '\n' ' ')"; done
    echo "-- ostree"; ostree --version | head -3; ostree admin --help 2>&1 | grep -E "set-default|pin" ; for c in /run/tessera-recover/*/root/ostree/repo/config; do echo "$c:"; cat "$c"; done
    for o in /run/tessera-recover/*/root/ostree/deploy/*/deploy/*.origin; do echo "$o:"; cat "$o"; done
    ls /run/tessera-recover/boot-*/grub2/ 2>/dev/null | tr '\n' ' '; echo
    # repairs, with the test install's password (tools/install-test.sh)
    for id in $(/usr/libexec/tessera/live-recover probe | python3 -c 'import json,sys; [print(i["id"]) for i in json.load(sys.stdin).get("installs", [])]'); do
      for req in '{"tool": "signin", "user": "tesstester", "password": "wrong"}' \
                 '{"tool": "signin", "user": "tesstester", "password": "tessera1"}' \
                 '{"tool": "shards", "user": "tesstester", "password": "tessera1"}' \
                 '{"tool": "version", "action": "keep", "index": 1, "user": "tesstester", "password": "tessera1"}' \
                 '{"tool": "version", "action": "default", "index": 1, "user": "tesstester", "password": "tessera1"}'; do
        echo "-- fix $req"; echo "$req" | /usr/libexec/tessera/live-recover fix "$id"
      done
      # break the boot menu the way a Windows update can, then repair it (the next VM pass boots the disk)
      echo "-- break boot"; efibootmgr -v 2>&1 | grep -E "^Boot" | cut -c1-160
      for n in $(efibootmgr 2>/dev/null | grep -iE "^Boot[0-9A-F]{4}\*? +(fedora|tessera|bazzite)" | cut -c5-8); do efibootmgr -q -b "$n" -B; done
      umount /run/tessera-recover/esp-* 2>/dev/null || :
      esp=$(lsblk -nrpo PATH,FSTYPE "$(lsblk -nrpo PKNAME "$(findmnt -nro SOURCE /run/tessera-recover/"${id%%:*}" | head -1)")" | awk '$2=="vfat"{print $1; exit}')
      mkdir -p /tmp/esp && mount "$esp" /tmp/esp && rm -f /tmp/esp/EFI/fedora/grub.cfg && ls /tmp/esp/EFI/fedora | tr '\n' ' '; echo; umount /tmp/esp
      echo "-- diagnose (broken)"; /usr/libexec/tessera/live-recover diagnose "$id" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps([f for f in d.get("findings",[]) if f["key"] in ("bootmenu","firmware")])); print(json.dumps(d.get("boot")))'
      echo "-- fix boot"; echo '{"tool": "boot", "user": "tesstester", "password": "tessera1"}' | /usr/libexec/tessera/live-recover fix "$id"
      echo "-- after boot fix"; efibootmgr -v 2>&1 | grep -E "^Boot" | cut -c1-160
      /usr/libexec/tessera/live-recover diagnose "$id" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps([f for f in d.get("findings",[]) if f["key"] in ("bootmenu","firmware")])); print(json.dumps(d.get("boot")))'
      for mode in look repair; do
        echo "-- check ($mode)"
        if [ $mode = look ]; then /usr/libexec/tessera/live-recover check "$id"; else echo '{"user": "tesstester", "password": "tessera1"}' | /usr/libexec/tessera/live-recover check "$id" --repair; fi
        for t in $(seq 1 600); do /usr/libexec/tessera/live-recover state | grep -q '"phase": "checking"' || break; sleep 1; done
        /usr/libexec/tessera/live-recover state
      done
      echo "-- drives"; /usr/libexec/tessera/live-recover drives
      stick=$(/usr/libexec/tessera/live-recover drives | python3 -c 'import json,sys; d=json.load(sys.stdin).get("drives") or [{}]; print(d[0].get("uuid",""))')
      if [ -n "$stick" ]; then
        echo "-- backup"; printf '{"user": "tesstester", "password": "tessera1", "who": "tesstester", "drive": "%s", "what": "mine"}' "$stick" | /usr/libexec/tessera/live-recover backup "$id"
        for t in $(seq 1 120); do /usr/libexec/tessera/live-recover state | grep -q '"phase": "copying"' || break; sleep 1; done
        echo "-- backup state"; /usr/libexec/tessera/live-recover state
        echo "-- the home folder"; for h in /run/tessera-recover/*/home/tesstester /run/tessera-recover/*/var/home/tesstester; do [ -d "$h" ] && { du -sb "$h"; find "$h" -type f -printf '%s %P\n' | head -15; }; done
        echo "-- on the stick"; mkdir -p /tmp/stick && mount -o ro UUID="$stick" /tmp/stick && { find /tmp/stick -type f -printf '%s %P\n' | head -20; umount /tmp/stick; }
      fi
      echo "-- after"; /usr/libexec/tessera/live-recover probe
      for e in /run/tessera-recover/boot-*/loader/entries/*.conf; do echo "$e: $(grep -E '^(title|options)' "$e" | tr '\n' ' ' | cut -c1-200)"; done
    done
    echo "-- mounts"; grep tessera-recover /proc/mounts
    echo "-- lsblk"; lsblk -o NAME,FSTYPE,LABEL,SIZE,MOUNTPOINTS
    echo "tessera-recovertest: end"
  } > "$out" 2>&1
  exit 0
fi
grep -qw 'tessera.debug' /proc/cmdline || exit 0
out=/dev/ttyS0
[ -w "$out" ] || out=/dev/console
while true; do
  sleep 45
  {
    echo "==== tessera debug $(date -Is)"
    systemctl --no-pager --plain list-units --state=failed 2>&1 | head -20
    journalctl -b --no-pager -o short-monotonic -n 60 -p 0..4 2>&1 | cut -c1-220
    echo "---- display manager"
    journalctl -b --no-pager -o cat -n 25 -u sddm -u plasmalogin -u display-manager 2>&1 | cut -c1-220
    echo "---- session.log"
    tail -n 40 /home/liveuser/.local/state/tessera/session.log 2>&1 | cut -c1-220
    echo "---- live-session.log"
    tail -n 20 /home/liveuser/.local/state/tessera/live-session.log 2>&1 | cut -c1-220
    echo "---- gpu"
    ls /dev/dri 2>&1; loginctl list-sessions --no-pager 2>&1 | head
  } > "$out" 2>&1
done
