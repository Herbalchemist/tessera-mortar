"""Install Tessera from the live USB onto a disk.

Runs as root (the live user may run exactly this program through sudo, see sudoers.d) and is driven by
the Install Tessera screens in the launcher. Everything the launcher hands over is checked here: it
picks from what `probe` offered, never paths or commands of its own.

  live-install probe          what this machine has: disks, graphics, Secure Boot, images, time zones (JSON)
  live-install run            install; the choices come as JSON on stdin (so the password never
                              touches a file). Progress goes to /run/tessera-install/state.json.
  live-install state          print the progress file

The install itself is done by Anaconda (Fedora's installer, the same engine Bazzite's ISO uses) from
a kickstart written here, from the Tessera images stored on the USB, with no network needed.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import time

IMAGES_DIRS = [os.environ.get("TESSERA_IMAGES_DIR", ""), "/run/initramfs/live/tessera-images", "/usr/share/tessera-install/images"]
REGISTRY = os.environ.get("TESSERA_REGISTRY", "ghcr.io/herbalchemist")
SB_KEY = os.environ.get("TESSERA_SB_KEY", "/usr/share/tessera-install/secure-boot-key.der")
SB_PASSWORD = "universalblue"  # the Universal Blue key's enrollment password (docs.bazzite.gg/sb)
STATE_DIR = os.environ.get("TESSERA_INSTALL_STATE", "/run/tessera-install")
ANACONDA = os.environ.get("TESSERA_ANACONDA", "/usr/sbin/anaconda")
IMAGE_FOR = {"standard": "tessera", "nvidia": "tessera-nvidia", "nvidia-open": "tessera-nvidia-open"}
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
RESERVED_USERS = {"root", "liveuser", "bin", "daemon", "adm", "nobody", "sddm", "gdm", "tessera"}
TZ_RE = re.compile(r"^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}$")
HOST_RE = re.compile(r"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$")


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


# ---------------------------------------------------------------- what the machine has
def images_dir():
    for d in IMAGES_DIRS:
        if d and os.path.isfile(os.path.join(d, "index.json")):
            return d
    return None


def images_available(d):
    """Names of the builds in the OCI image layout (index.json ref names)."""
    if not d:
        return []
    try:
        with open(os.path.join(d, "index.json")) as f:
            idx = json.load(f)
    except (OSError, ValueError):
        return []
    names = []
    for m in idx.get("manifests", []):
        n = (m.get("annotations") or {}).get("org.opencontainers.image.ref.name", "")
        if n in IMAGE_FOR.values():
            names.append(n)
    return sorted(set(names))


def live_device():
    """The disk the live system runs from: never offered as a target."""
    for target in ("/run/initramfs/live", "/run/initramfs/isoscan"):
        r = run(["findmnt", "-n", "-o", "SOURCE", target])
        src = r.stdout.strip()
        if src:
            p = run(["lsblk", "-n", "-o", "PKNAME", src]).stdout.strip().splitlines()
            return "/dev/" + p[0] if p and p[0] else src
    return None


def disks(lsblk_json=None, live=None):
    if lsblk_json is None:
        r = run(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,TRAN,RM,TYPE,RO,HOTPLUG"])
        lsblk_json = r.stdout or "{}"
    try:
        devs = json.loads(lsblk_json).get("blockdevices", [])
    except ValueError:
        devs = []
    out = []
    for d in devs:
        path = d.get("path") or ("/dev/" + d.get("name", ""))
        if d.get("type") != "disk" or str(d.get("ro")) in ("1", "True", "true"):
            continue
        if re.match(r"^/dev/(loop|zram|ram|sr|fd)", path):
            continue
        size = int(d.get("size") or 0)
        if size < 64 * 1000 ** 3:  # Tessera wants room for the system plus games
            continue
        out.append({
            "path": path,
            "size": size,
            "model": (d.get("model") or "").strip()[:60] or "Disk",
            "transport": (d.get("tran") or "").lower(),
            "removable": str(d.get("rm")) in ("1", "True", "true") or str(d.get("hotplug")) in ("1", "True", "true"),
            "live": bool(live) and path == live,
        })
    return [d for d in out if not d["live"]]


# ---------------------------------------------------------------- what is already on a disk
# Tessera can go next to other systems: into free space that is already there, or into space made
# by removing partitions the person picked. Nothing is ever shrunk or moved, and the disk's boot
# partition (the EFI system partition, which Windows and other systems start from) is reused,
# never formatted or removed.
MIN_ROOM = 40 * 1000 ** 3       # the least room Tessera is put in, next to something else
NEW_ESP = 600 * 1024 ** 2       # a boot partition of its own, on a disk that has none
BOOT = 1024 * 1024 ** 2         # /boot
ESP_FREE_NEEDED = 40 * 1024 ** 2  # Tessera's boot files on a shared boot partition
ALIGN = 1024 * 1024             # partitions start on whole MiB
ESP_TYPE = "c12a7328-f81f-11d2-ba4b-00a0c93ec93b"


def free_regions(table):
    """Free stretches of a disk, [[start, end)] in bytes, from `sfdisk --json` (only whole MiB count)."""
    t = table.get("partitiontable") or {}
    sector = int(t.get("sectorsize") or 512)
    first, last = int(t.get("firstlba") or 2048), int(t.get("lastlba") or 0)
    used = sorted((int(q["start"]), int(q["start"]) + int(q["size"])) for q in t.get("partitions", []))
    out, at = [], first
    for a, b in used + [(last + 1, last + 1)]:
        if a > at:
            out.append([at * sector, a * sector])
        at = max(at, b)
    return [[-(-a // ALIGN) * ALIGN, b // ALIGN * ALIGN] for a, b in out if b // ALIGN * ALIGN - -(-a // ALIGN) * ALIGN >= ALIGN]


def biggest_room(table, removing=()):
    """The biggest stretch Tessera could have: free space, plus the partitions being removed, where
    they join up. Partitions are found by their node (/dev/...)."""
    t = table.get("partitiontable") or {}
    sector = int(t.get("sectorsize") or 512)
    spans = [list(r) for r in free_regions(table)]
    for q in t.get("partitions", []):
        if q.get("node") in removing:
            spans.append([int(q["start"]) * sector, (int(q["start"]) + int(q["size"])) * sector])
    spans.sort()
    best, cur = 0, None
    for a, b in spans:
        if cur and a <= cur[1] + ALIGN:   # touching (or only alignment apart): one stretch
            cur[1] = max(cur[1], b)
        else:
            if cur:
                best = max(best, cur[1] - cur[0])
            cur = [a, b]
    if cur:
        best = max(best, cur[1] - cur[0])
    return best


def describe_partition(q):
    fstype = (q.get("fstype") or "").lower()
    ptype = (q.get("parttype") or "").lower()
    name = (q.get("parttypename") or "").strip()
    label = (q.get("label") or q.get("partlabel") or "").strip()
    esp = ptype == ESP_TYPE or name.lower() == "efi system"
    if esp:
        what = "Boot partition (EFI)"
    elif fstype == "ntfs" or fstype == "bitlocker" or "microsoft" in name.lower():
        what = "Windows" + (" (encrypted with BitLocker)" if fstype == "bitlocker" else "") + (" recovery" if "recovery" in (name + label).lower() else "")
    elif fstype in ("btrfs", "ext4", "ext3", "xfs", "f2fs", "crypto_luks") or "linux" in name.lower():
        what = "Linux" + (" (encrypted)" if fstype == "crypto_luks" else "")
    elif "swap" in fstype or "swap" in name.lower():
        what = "Linux swap"
    else:
        what = name or fstype or "Partition"
    return {"path": q.get("path"), "size": int(q.get("size") or 0), "fstype": fstype, "label": label[:40],
            "what": what, "esp": esp}


def look_in_esp(path):
    """Mounts a boot partition read-only for a moment: which systems start from it, and room left.
    None if it can't be looked at (then nobody installs next to it)."""
    import tempfile
    d = tempfile.mkdtemp(prefix="tessera-esp-")
    try:
        if run(["mount", "-o", "ro,nosuid,nodev,noexec", path, d]).returncode != 0:
            return None
        try:
            efi = next((os.path.join(d, n) for n in os.listdir(d) if n.lower() == "efi"), None)
            names = sorted(os.listdir(efi)) if efi else []
            st = os.statvfs(d)
            return {"systems": [n for n in names if n.lower() != "boot"], "free": st.f_bavail * st.f_frsize}
        finally:
            run(["umount", d])
    except OSError:
        return None
    finally:
        try:
            os.rmdir(d)
        except OSError:
            pass


def partitions_of(disk, lsblk):
    """The partitions in an `lsblk -J` answer. Without a NAME column lsblk lists them beside the disk,
    not under it ("children"), so both shapes are read."""
    out, todo = [], list(lsblk.get("blockdevices") or [])
    while todo:
        q = todo.pop(0)
        todo[:0] = q.get("children") or []
        if q.get("type") == "part" and str(q.get("path") or "").startswith(disk):
            out.append(q)
    return out


def disk_layout(path, table=None, parts=None, esp_look=look_in_esp):
    """What is on one disk, and how Tessera may use it: {'pttype','partitions','free','esp','systems',
    'alongside': {'ok', 'room', 'why'}}."""
    if table is None:
        r = run(["sfdisk", "--json", path])
        try:
            table = json.loads(r.stdout or "{}")
        except ValueError:
            table = {}
    if parts is None:
        r = run(["lsblk", "-J", "-b", "-o", "PATH,SIZE,FSTYPE,LABEL,PARTLABEL,PARTTYPE,PARTTYPENAME,TYPE", path])
        try:
            parts = partitions_of(path, json.loads(r.stdout or "{}"))
        except (ValueError, AttributeError):
            parts = []
    t = table.get("partitiontable") or {}
    pttype = t.get("label") or ""
    partitions = [describe_partition(q) for q in parts]
    esps = [q for q in partitions if q["esp"]]
    esp = None
    if esps:
        look = esp_look(esps[0]["path"]) if pttype == "gpt" else None
        esp = {"path": esps[0]["path"], "size": esps[0]["size"], **(look or {"systems": None, "free": None})}
    systems = []
    if esp and esp["systems"]:
        for n in esp["systems"]:
            systems.append({"microsoft": "Windows", "fedora": "Fedora-based Linux (Fedora, Bazzite, Nobara...)",
                            "ubuntu": "Ubuntu", "debian": "Debian", "opensuse": "openSUSE", "arch": "Arch Linux",
                            "steamos": "SteamOS"}.get(n.lower(), n))
    elif any(q["what"].startswith("Windows") for q in partitions):
        systems.append("Windows")
    if any(q["what"].startswith("Linux") for q in partitions) and not any("Linux" in s or s in ("Ubuntu", "Debian", "openSUSE", "SteamOS") for s in systems):
        systems.append("Linux")
    room = biggest_room(table)
    along = can_go_alongside(pttype, esp, partitions, room)
    if len(t.get("partitions") or []) != len(partitions):   # two readings of the disk disagree: leave it alone
        along = {"ok": False, "room": room, "why": "Couldn't read this disk's partitions reliably, so it's left alone. Erase it, or install on another disk."}
    return {"pttype": pttype, "partitions": partitions, "free": room, "esp": esp, "systems": systems, "table": table,
            "alongside": along}


def can_go_alongside(pttype, esp, partitions, room):
    """Whether Tessera may share this disk, and if not, why (in words for the person)."""
    def no(why):
        return {"ok": False, "room": room, "why": why}
    if not os.path.isdir(EFI_DIR):
        return no("This PC started the USB the old way (not UEFI). Installing next to another system needs UEFI.")
    if not pttype and not partitions:
        return no("This disk is empty: choose Erase to use all of it.")
    if pttype != "gpt":
        return no("This disk uses the old MBR layout, which Tessera can't share. Erase it to install, or install on another disk.")
    if esp is not None:
        if esp["systems"] is None:
            return no("Couldn't look inside this disk's boot partition, so it's left alone.")
        if any(s.lower() == "fedora" for s in esp["systems"]):
            return no("A Fedora-based system (Fedora, Bazzite, Nobara...) already starts from this disk. Tessera is one too, "
                      "and would replace its boot files. Erase the whole disk instead, or install on another disk.")
        if esp["free"] is not None and esp["free"] < ESP_FREE_NEEDED:
            return no("This disk's boot partition is nearly full, so Tessera's boot files wouldn't fit.")
    return {"ok": True, "room": room, "why": ""}


EFI_DIR = os.environ.get("TESSERA_EFI_DIR", "/sys/firmware/efi")


def secure_boot():
    efi = os.path.isdir("/sys/firmware/efi")
    state = "unknown"
    if efi:
        r = run(["mokutil", "--sb-state"])
        t = (r.stdout + r.stderr).lower()
        state = "on" if "enabled" in t else "off" if "disabled" in t else "unknown"
    return {"efi": efi, "state": state, "keyAvailable": os.path.isfile(SB_KEY)}


def gpus(pci_dir="/sys/bus/pci/devices"):
    out = []
    try:
        names = sorted(os.listdir(pci_dir))
    except OSError:
        return out
    for d in names:
        def rd(f):
            try:
                with open(os.path.join(pci_dir, d, f)) as fh:
                    return fh.read().strip().lower().replace("0x", "")
            except OSError:
                return ""
        cls = rd("class")
        if cls.startswith("03"):
            out.append({"slot": d, "vendor": rd("vendor"), "device": rd("device"), "cls": cls})
    return out


def timezones():
    r = run(["timedatectl", "list-timezones", "--no-pager"])
    zones = [z for z in r.stdout.split() if TZ_RE.match(z)]
    return zones or ["UTC"]


def online(timeout=5):
    """Can this machine reach the image registry? (Any HTTP answer counts; it says 401 without a login.)"""
    import urllib.request
    import urllib.error
    host = REGISTRY.split("/")[0]
    try:
        urllib.request.urlopen(f"https://{host}/v2/", timeout=timeout)
        return True
    except urllib.error.HTTPError:
        return True
    except Exception:  # noqa: BLE001 - no network, no DNS, timeout: all mean offline
        return False


def probe():
    d = images_dir()
    # A USB without builds on it (Mortar's "Online install") downloads the chosen build while installing.
    source = "usb" if d else "online"
    return {
        "ok": True,
        "source": source,
        "online": online() if source == "online" else None,
        "disks": [{**d, **disk_layout(d["path"])} for d in disks(live=live_device())],
        "gpus": gpus(),
        "secureBoot": secure_boot(),
        "images": images_available(d) if d else sorted(IMAGE_FOR.values()),
        "imagesDir": d,
        "timezones": timezones(),
        "memory": os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES"),
    }


# ---------------------------------------------------------------- the install
class Bad(Exception):
    pass


def check(choices, offered):
    """Turn what the launcher sent into safe values, or raise Bad with a message for the person."""
    if not isinstance(choices, dict):
        raise Bad("Nothing to install.")
    disk = choices.get("disk")
    if disk not in [d["path"] for d in offered["disks"]]:
        raise Bad("That disk can't be used.")
    variant = choices.get("variant")
    if variant not in IMAGE_FOR:
        raise Bad("Unknown graphics build.")
    if IMAGE_FOR[variant] not in offered["images"]:
        raise Bad("That graphics build isn't on this USB.")
    if offered.get("source") == "online" and not offered.get("online"):
        raise Bad("This USB downloads Tessera while installing: connect to the internet first.")
    user = str(choices.get("user", "")).strip().lower()
    if not USER_RE.match(user) or user in RESERVED_USERS:
        raise Bad("Pick another user name: lowercase letters and numbers, starting with a letter.")
    full = re.sub(r"[\x00-\x1f\"\\:]", "", str(choices.get("fullName", "")))[:60].strip()
    password = choices.get("password")
    if not isinstance(password, str) or len(password) < 4 or len(password) > 200 or "\n" in password:
        raise Bad("The password needs at least 4 characters.")
    tz = choices.get("timezone") or "UTC"
    if tz not in offered["timezones"]:
        raise Bad("Unknown time zone.")
    host = str(choices.get("hostname") or "tessera").lower()
    if not HOST_RE.match(host):
        host = "tessera"
    sb = choices.get("secureBoot") if choices.get("secureBoot") in ("auto", "manual") else "auto"
    target = next(d for d in offered["disks"] if d["path"] == disk)
    layout, remove = check_layout(choices, target)
    esp = (target.get("esp") or {}).get("path") if layout != "erase" else None
    return {"disk": disk, "layout": layout, "remove": remove, "esp": esp, "variant": variant, "image": IMAGE_FOR[variant], "user": user, "fullName": full,
            "password": password, "timezone": tz, "hostname": host, "secureBoot": sb}


def check_layout(choices, d):
    """How the disk is used: 'erase' (all of it, as before), 'alongside' (its free space only), or
    'replace' (the partitions picked, plus free space next to them). Returns (layout, [partition names])."""
    layout = choices.get("layout") or "erase"
    if layout == "erase":
        return "erase", []
    if layout not in ("alongside", "replace"):
        raise Bad("Unknown way to use the disk.")
    ok = d.get("alongside") or {}
    if not ok.get("ok"):
        raise Bad(ok.get("why") or "Tessera can't share this disk.")
    remove = []
    if layout == "replace":
        picked = choices.get("remove")
        if not isinstance(picked, list) or not picked:
            raise Bad("Pick the partitions to remove.")
        parts = {q["path"]: q for q in d.get("partitions", [])}
        for p in picked:
            if p not in parts:
                raise Bad("That partition isn't on this disk.")
            if parts[p]["esp"]:
                raise Bad("The boot partition stays: other systems start from it.")
        if len(set(picked)) != len(picked):
            raise Bad("Pick each partition once.")
        remove = sorted(picked)
        room = biggest_room(d["table"], remove) if d.get("table") else ok.get("room", 0) + sum(parts[p]["size"] for p in remove)
    else:
        room = ok.get("room", 0)
    need = MIN_ROOM + BOOT + (0 if d.get("esp") else NEW_ESP)
    if room < need:
        raise Bad(f"Not enough room: Tessera needs at least {need // 1000 ** 3} GB in one piece, and there is {room // 1000 ** 3} GB.")
    return layout, [p.replace("/dev/", "") for p in remove]


def hash_password(pw):
    r = subprocess.run(["openssl", "passwd", "-6", "-stdin"], input=pw + "\n", capture_output=True, text=True)
    h = r.stdout.strip()
    if r.returncode != 0 or not h.startswith("$6$"):
        raise Bad("Couldn't set the password.")
    return h


def storage(c):
    """The kickstart's disk part. Erase: the whole disk, laid out by Anaconda as before. Next to other
    systems: only free space (and the partitions picked), the same layout spelled out, and the disk's
    own boot partition reused unformatted, so Windows and the rest still start."""
    disk = c["disk"].replace("/dev/", "")
    if c.get("layout", "erase") == "erase":
        return ["zerombr", f"clearpart --all --initlabel --drives={disk}", "autopart --type=btrfs --noswap"]
    out = [f"clearpart --list={','.join(c['remove'])}" if c.get("remove") else "clearpart --none"]
    esp = c.get("esp")
    out.append(f"part /boot/efi --onpart={esp.replace('/dev/', '')} --noformat" if esp
               else f"part /boot/efi --fstype=efi --size={NEW_ESP // 1024 ** 2} --ondisk={disk}")
    out += [
        f"part /boot --fstype=ext4 --size={BOOT // 1024 ** 2} --ondisk={disk}",
        f"part btrfs.tessera --fstype=btrfs --grow --ondisk={disk}",
        "btrfs none --label=tessera btrfs.tessera",
        "btrfs / --subvol --name=root LABEL=tessera",
        "btrfs /home --subvol --name=home LABEL=tessera",
        "btrfs /var --subvol --name=var LABEL=tessera",
    ]
    return out


def kickstart(c, images, pw_hash, sb_key=SB_KEY, registry=REGISTRY):
    q = shlex.quote
    disk = c["disk"].replace("/dev/", "")
    ref = f"{registry}/{c['image']}:latest"
    lines = [
        "# Written by Tessera's installer (live-install). Installs one Tessera build from the USB.",
        "cmdline",
        "lang en_US.UTF-8",
        "keyboard us",
        f"timezone {c['timezone']} --utc",
        f"network --hostname={c['hostname']}",
        f"ignoredisk --only-use={disk}",
        *storage(c),
        "rootpw --lock",
        f"user --name={c['user']} --groups=wheel --iscrypted --password={pw_hash}"
        + (f' --gecos="{c["fullName"]}"' if c["fullName"] else ""),
        (f"ostreecontainer --url={images}:{c['image']} --transport=oci --no-signature-verification" if images
         else f"ostreecontainer --url={ref} --transport=registry --no-signature-verification"),
        "",
        # Bazzite's installer does these two; Bazzite's own tools look for the bazzite_xboot label.
        *(["%pre-install --erroronfail", "rm -rf /mnt/sysroot/boot/efi/EFI/fedora", "%end", ""] if c.get("layout", "erase") == "erase" else []),
        "%pre-install --erroronfail --log=/tmp/tessera-xboot.log",
        "xboot_dev=$(findmnt -o SOURCE --nofsroot --noheadings -f --target /mnt/sysroot/boot)",
        '[ -n "$xboot_dev" ] && e2label "$xboot_dev" bazzite_xboot',
        "%end",
        "",
        # Updates come from the registry once the machine is online, and must carry Tessera's
        # signature (the image's /etc/containers/policy.json and /etc/pki/containers/tessera.pub).
        "%post --erroronfail --log=/tmp/tessera-origin.log",
        f"sed -i 's|^container-image-reference=.*|container-image-reference=ostree-image-signed:docker://{ref}|' /ostree/deploy/default/deploy/*.origin",
        "mkdir -p /etc/tessera",
        f"echo {q(c['user'])} > /etc/tessera/autologin-user",
        "%end",
        "",
        # The version installed today is kept for good: updates never remove it, so Boot options and
        # Recover can always start the original. Recover > Versions can stop keeping it.
        "%post --nochroot --log=/tmp/tessera-keep-original.log",
        "ostree admin --sysroot=/mnt/sysroot pin 0 || echo 'note: could not keep the original version'",
        "%end",
    ]
    if c["secureBoot"] == "auto":
        lines += [
            "",
            "%post --nochroot --log=/tmp/tessera-secureboot.log",
            "[ -d /sys/firmware/efi ] || exit 0",
            f"[ -f {q(sb_key)} ] || exit 0",
            "mokutil --timeout -1 || :",
            f"printf '%s\\n%s\\n' {SB_PASSWORD} {SB_PASSWORD} | mokutil --import {q(sb_key)} || :",
            "%end",
        ]
    return "\n".join(lines) + "\n"


# Anaconda's own progress lines, mapped to rough percentages for the progress bar.
STAGES = [
    (re.compile(r"storage|partition|format", re.I), 8, "Preparing the disk"),
    (re.compile(r"deploy|pull|ostree|container|fetch|layer|import", re.I), 20, "Copying Tessera onto the disk"),
    (re.compile(r"configur.*installed system|post-install|post installation", re.I), 85, "Setting up the system"),
    (re.compile(r"boot ?loader", re.I), 92, "Installing the boot loader"),
    (re.compile(r"user|password|account", re.I), 95, "Creating your account"),
]


def kmsg(text):
    """A line in the kernel log (and so on a serial console), for following an install from outside."""
    try:
        with open("/dev/kmsg", "w") as f:
            f.write(f"<4>tessera-install: {text}\n")
    except OSError:
        pass


def write_state(**kw):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = os.path.join(STATE_DIR, "state.json.tmp")
    with open(tmp, "w") as f:
        json.dump({"at": time.time(), **kw}, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(STATE_DIR, "state.json"))


def install(choices):
    offered = probe()
    try:
        c = check(choices, offered)
        pw = hash_password(c["password"])
    except Bad as e:
        write_state(phase="error", percent=0, line="", error=str(e))
        kmsg(f"refused: {e}")
        return 2
    os.makedirs(STATE_DIR, exist_ok=True)
    ks_path = os.path.join(STATE_DIR, "tessera.ks")
    fd = os.open(ks_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(kickstart(c, offered["imagesDir"], pw))
    write_state(phase="running", percent=2, line="Starting the installer", stage="Starting", disk=c["disk"], variant=c["variant"])
    kmsg(f"start {c['image']} on {c['disk']}")
    log = open(os.path.join(STATE_DIR, "install.log"), "a")
    # On a live system Anaconda runs some things (keyboard layouts) as the live user, whom it finds
    # through PKEXEC_UID; we come in through sudo instead, so hand it on.
    env = dict(os.environ)
    if "PKEXEC_UID" not in env:
        uid = env.get("SUDO_UID")
        if not uid:
            try:
                import pwd
                uid = str(pwd.getpwnam("liveuser").pw_uid)
            except KeyError:
                uid = None
        if uid and uid != "0":
            env["PKEXEC_UID"] = uid
    cmd = [ANACONDA, "--liveinst", "--cmdline", f"--kickstart={ks_path}"]
    if os.path.exists("/usr/bin/systemd-inhibit"):  # no sleep or screen blanking in the middle of it
        cmd = ["/usr/bin/systemd-inhibit", "--what=idle:sleep:handle-lid-switch", "--who=Install Tessera", "--why=Installing Tessera", *cmd]
    p = subprocess.Popen(cmd, env=env,
                         stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    percent, stage = 2, "Starting"
    buf, answered = "", False
    fd = p.stdout.fileno()
    while True:
        chunk = os.read(fd, 4096)
        if not chunk:
            break
        text = chunk.decode("utf-8", errors="replace")
        log.write(text)
        log.flush()
        buf += text
        # Without a reboot command Anaconda ends with "Installation complete. Press ENTER to quit"
        # (no newline after it); the screens take it from there.
        if not answered and "Installation complete" in buf:
            answered = True
            kmsg("anaconda finished")
            try:
                p.stdin.write(b"\n")
                p.stdin.flush()
            except OSError:
                pass
        *lines, buf = re.split(r"[\r\n]", buf)
        for raw in lines:
            line = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", raw).strip()
            if not line:
                continue
            for rx, pc, name in STAGES:
                if rx.search(line) and pc >= percent:
                    if name != stage:
                        kmsg(f"stage {name}")
                    percent, stage = pc, name
                    break
            else:
                if stage == "Copying Tessera onto the disk" and percent < 84:
                    percent += 0.25  # the long copy: creep forward so the bar never looks stuck
            write_state(phase="running", percent=int(percent), line=line[:160], stage=stage, disk=c["disk"], variant=c["variant"])
    code = p.wait()
    log.close()
    if code != 0:
        write_state(phase="error", percent=int(percent), line="", error="The install didn't finish. Nothing on the USB was changed; you can try again.", code=code)
        kmsg(f"error: anaconda exited with {code}")
        for name in (os.path.join(STATE_DIR, "install.log"), "/tmp/anaconda.log", "/tmp/packaging.log"):
            try:
                with open(name, errors="replace") as f:
                    for l in f.readlines()[-12:]:
                        kmsg(f"log {os.path.basename(name)}: {l.strip()[:200]}")
            except OSError:
                pass
        return 1
    enrolled = False
    if c["secureBoot"] == "auto" and os.path.isfile(SB_KEY):
        enrolled = "already in the enrollment request" in run(["mokutil", "-t", SB_KEY]).stdout.lower()
    run(["sync"])  # everything on the disk before saying so: people power off at "done"
    kmsg("done")
    write_state(phase="done", percent=100, line="", stage="Done", enrolled=enrolled, secureBoot=offered["secureBoot"]["state"], variant=c["variant"], user=c["user"])
    return 0


def main(argv):
    if argv[:1] == ["probe"]:
        print(json.dumps(probe()))
        return 0
    if argv[:1] == ["online"]:
        print(json.dumps({"online": online()}))
        return 0
    if argv[:1] == ["state"]:
        try:
            with open(os.path.join(STATE_DIR, "state.json")) as f:
                print(f.read())
        except OSError:
            print(json.dumps({"phase": "idle"}))
        return 0
    if argv[:1] == ["run"]:
        if os.geteuid() != 0:
            print("live-install run needs root", file=sys.stderr)
            return 1
        try:
            choices = json.loads(sys.stdin.read(65536) or "{}")
        except ValueError:
            choices = None
        return install(choices)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
