"""Recover a Tessera that won't start, from the Tessera USB.

Runs as root (the live user may run exactly this program through sudo, see sudoers.d) and is driven by
the Recover screens in the launcher. Like live-install, it only ever acts on what `probe` found: the
screens hand over an install's id from that list, never a path or a command of their own.

  live-recover probe            the Tessera installs on this machine's disks (JSON)
  live-recover diagnose ID      what's wrong, as far as can be seen: versions, sign-in at boot, space,
                                the disk's health, errors from the last start (JSON)
  live-recover report ID        a problem report from that, saved in the install's Tessera folder (JSON)
  live-recover space ID         what is using the disk (JSON)
  live-recover drives           USB drives a backup can go to (JSON)
  live-recover backup ID        copy a home folder to a USB drive, in the background; JSON on stdin:
                                {"user": admin, "password": ..., "who": person, "drive": uuid, "what": "mine"|"all"}
  live-recover state            the backup's progress (JSON)
  live-recover cancel           stop the backup
  live-recover fix ID           a repair; JSON on stdin: {"tool": ..., "user": ..., "password": ...}
      clean    free up space: {"what": ["caches", "shaders", "trash"]} in everyone's home folder
      signin   start in Tessera at boot again (turns the automatic sign-in back on)
      pin      remove the admin PIN (Tessera then starts without one; set a new one in Settings)
      shards   turn off every shard (code add-on), in case one stops Tessera from starting
    Every repair needs the password of an administrator account of that install (checked against its
    own /etc/shadow); the password comes on stdin, never on the command line.

Nothing is mounted for writing except during a repair, and only the files that repair changes are
touched. Files in people's home folders keep their owner and permissions.

TESSERA_RECOVER_MNT, TESSERA_RECOVER_LSBLK, TESSERA_LIBCRYPT are only for tests.
"""
import ctypes
import ctypes.util
import datetime
import hmac
import json
import os
import re
import shutil
import subprocess
import sys

MNT = os.environ.get("TESSERA_RECOVER_MNT", "/run/tessera-recover")
TESSERA_ORIGIN = re.compile(r"herbalchemist/tessera", re.I)
ID_RE = re.compile(r"^[0-9a-fA-F-]{8,40}:[A-Za-z0-9._-]{1,40}$")
USER_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
TOOLS = ("signin", "pin", "shards", "version", "clean")
VERSION_ACTIONS = ("default", "keep", "unkeep")
OSTREE = os.environ.get("TESSERA_OSTREE") or shutil.which("ostree") or "/usr/bin/ostree"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def read(path, limit=1 << 20):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read(limit)
    except OSError:
        return None


def kv(text):
    """KEY=value lines (os-release, .origin) -> dict."""
    out = {}
    for line in (text or "").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip().strip('"').strip("'")
    return out


# ---------------------------------------------------------------- finding installs
def deployments(sysroot, stateroot):
    """The deployments of one stateroot: [{dir, name, version, image, tessera}]."""
    base = os.path.join(sysroot, "ostree", "deploy", stateroot, "deploy")
    out = []
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return out
    for name in names:
        d = os.path.join(base, name)
        if name.endswith(".origin") or not os.path.isdir(d) or os.path.islink(d):
            continue
        rel = kv(read(os.path.join(d, "usr", "lib", "os-release")))
        origin = read(os.path.join(base, name + ".origin")) or ""
        image = (re.search(r"container-image-reference=\S*?docker://(\S+)", origin) or [None, ""])[1]
        tessera = bool(TESSERA_ORIGIN.search(origin)) or "tessera" in (rel.get("NAME", "") + rel.get("PRETTY_NAME", "")).lower()
        version = rel.get("OSTREE_VERSION") or rel.get("IMAGE_VERSION") or re.sub(r"\s*\(.*\)$", "", rel.get("VERSION", ""))
        pinned = bool(re.search(r"^\s*pinned\s*=\s*true\s*$", origin, re.M))
        out.append({"dir": d, "name": name, "version": version, "pinned": pinned,
                    "pretty": rel.get("PRETTY_NAME", ""), "image": image, "tessera": tessera})
    return out


def boot_entries(boot, sysroot, stateroot):
    """Which deployment each boot entry starts, in the boot menu's order: [{index, title, name}]."""
    entries_dir = os.path.join(boot, "loader", "entries")
    out = []
    try:
        files = sorted(f for f in os.listdir(entries_dir) if f.endswith(".conf"))
    except OSError:
        return out
    for f in files:
        conf = {}
        for line in (read(os.path.join(entries_dir, f)) or "").splitlines():
            parts = line.strip().split(None, 1)
            if len(parts) == 2:
                conf[parts[0]] = parts[1]
        m = re.search(r"(?:^|\s)ostree=(/ostree/boot\.\d+/([^/\s]+)/[^\s]+)", conf.get("options", ""))
        if not m or m.group(2) != stateroot:
            continue
        name = None
        try:
            target = os.readlink(os.path.join(sysroot, m.group(1).lstrip("/")))
            name = os.path.basename(os.path.normpath(target))
        except OSError:
            pass
        idx = re.search(r"\(ostree:(\d+)\)", conf.get("title", ""))
        out.append({"index": int(idx.group(1)) if idx else len(out), "title": conf.get("title", ""), "name": name})
    return sorted(out, key=lambda e: e["index"])


def passwd_users(etc):
    users = []
    for line in (read(os.path.join(etc, "passwd")) or "").splitlines():
        p = line.split(":")
        if len(p) >= 7 and USER_RE.match(p[0]) and p[2].isdigit() and 1000 <= int(p[2]) < 60000 and not re.search(r"(nologin|false)$", p[6]):
            users.append({"name": p[0], "uid": int(p[2]), "gid": int(p[3]) if p[3].isdigit() else int(p[2]), "home": p[5]})
    return users


def wheel(etc):
    for line in (read(os.path.join(etc, "group")) or "").splitlines():
        p = line.split(":")
        if len(p) >= 4 and p[0] == "wheel":
            return [u for u in p[3].split(",") if u]
    return []


def var_roots(mnt, sysroot, stateroot):
    """Where the install's /var may be: its own subvolume ('var'), or the stateroot's var folder."""
    return [p for p in (os.path.join(mnt, "var"), os.path.join(sysroot, "ostree", "deploy", stateroot, "var")) if os.path.isdir(p)]


def homes_root(mnt, sysroot, stateroot, users):
    """Where the home folders are: the 'home' subvolume, or the install's /var/home."""
    cands = [os.path.join(mnt, "home")] + [os.path.join(v, "home") for v in var_roots(mnt, sysroot, stateroot)] + [os.path.join(sysroot, "var", "home")]
    for cand in cands:
        if os.path.isdir(cand) and (not users or any(os.path.isdir(os.path.join(cand, u["name"])) for u in users)):
            return cand
    return None


def find_installs(mnt, boot=None, fs=None):
    """Tessera installs in one mounted file system (and its boot partition, if found)."""
    found = []
    for sysroot in (mnt, os.path.join(mnt, "root")):
        base = os.path.join(sysroot, "ostree", "deploy")
        try:
            staterooots = sorted(os.listdir(base))
        except OSError:
            continue
        for sr in staterooots:
            deps = deployments(sysroot, sr)
            if not any(d["tessera"] for d in deps):
                continue
            entries = boot_entries(boot, sysroot, sr) if boot else []
            by_name = {d["name"]: d for d in deps}
            ordered = [dict(by_name[e["name"]], index=e["index"]) for e in entries if e["name"] in by_name]
            for d in deps:  # deployments without a boot entry (shouldn't happen) go last
                if d["name"] not in {o["name"] for o in ordered}:
                    ordered.append(dict(d, index=len(ordered)))
            newest = ordered[0]
            etc = os.path.join(newest["dir"], "etc")
            users = passwd_users(etc)
            hr = homes_root(mnt, sysroot, sr, users)
            found.append({
                "sysroot": sysroot, "stateroot": sr, "deployments": ordered, "etc": etc,
                "users": [dict(u, admin=u["name"] in wheel(etc), path=os.path.join(hr, u["name"]) if hr else None) for u in users],
                "hostname": (read(os.path.join(etc, "hostname")) or "").strip(),
                "fs": fs,
            })
    return found


def lsblk():
    if os.environ.get("TESSERA_RECOVER_LSBLK"):
        return json.loads(read(os.environ["TESSERA_RECOVER_LSBLK"]))
    r = run(["lsblk", "-J", "-b", "-o", "NAME,PATH,PKNAME,TYPE,FSTYPE,LABEL,UUID,SIZE,RM,TRAN,MODEL,MOUNTPOINTS"])
    return json.loads(r.stdout or '{"blockdevices": []}')


def flat(devs, parent=None):
    for d in devs or []:
        yield d, parent
        yield from flat(d.get("children"), d)


def live_disk():
    """The disk the live system started from (never touched)."""
    for line in (read("/proc/mounts") or "").splitlines():
        p = line.split()
        if len(p) > 1 and p[1] in ("/run/initramfs/live", "/run/initramfs/isoscan"):
            r = run(["lsblk", "-no", "PKNAME", p[0]])
            return (r.stdout or "").strip() or os.path.basename(p[0])
    return None


def mounts_of(dev):
    """Every place a device is mounted (by its real path)."""
    real = os.path.realpath(dev)
    out = []
    for line in (read("/proc/mounts") or "").splitlines():
        p = line.split()
        if len(p) > 1 and p[0].startswith("/dev/") and os.path.realpath(p[0]) == real:
            out.append(p[1].replace("\\040", " "))
    return out


def release(dev):
    """Unmount a device everywhere this helper mounted it (a second, read-only mount of the same
    file system would keep it read-only)."""
    for m in reversed(mounts_of(dev)):
        if m.startswith(MNT.rstrip("/") + "/"):
            run(["umount", m])


def mount(dev, fstype, where, rw=False):
    os.makedirs(where, exist_ok=True)
    if os.path.ismount(where):
        return True
    opts = "rw" if rw else "ro"
    if fstype == "btrfs":
        opts += ",subvolid=5"
    return run(["mount", "-o", opts, dev, where]).returncode == 0


def probe():
    """[{id, device, ...install}] for every Tessera install on this machine's disks."""
    devs = list(flat(lsblk().get("blockdevices")))
    skip = live_disk()
    installs = []
    for d, parent in devs:
        if d.get("type") != "part" or d.get("fstype") not in ("btrfs", "xfs", "ext4") or not d.get("uuid"):
            continue
        disk = d.get("pkname") or (parent or {}).get("name")
        if skip and disk == skip:
            continue
        where = os.path.join(MNT, d["uuid"])
        if not mount(d["path"], d["fstype"], where):
            continue
        boot = None
        for b, bp in devs:  # the boot partition: same disk, has loader/entries
            if b.get("type") == "part" and (b.get("pkname") or (bp or {}).get("name")) == disk and b.get("fstype") in ("ext4", "xfs") and b.get("uuid") and b is not d:
                bw = os.path.join(MNT, "boot-" + b["uuid"])
                if mount(b["path"], b["fstype"], bw) and os.path.isdir(os.path.join(bw, "loader", "entries")):
                    boot = {"path": bw, "device": b["path"], "uuid": b["uuid"]}
                    break
                run(["umount", bw])  # not a boot partition
        found = find_installs(where, boot["path"] if boot else None, {"device": d["path"], "uuid": d["uuid"], "type": d["fstype"]})
        if not found:
            run(["umount", where])  # nothing of Tessera's here: don't keep it mounted
            continue
        for inst in found:
            inst["id"] = f"{d['uuid']}:{inst['stateroot']}"
            inst["mount"] = where
            inst["disk"] = {"name": disk, "model": ((parent or {}).get("model") or "").strip(), "size": int((parent or {}).get("size") or 0)}
            inst["boot"] = boot
            installs.append(inst)
    return installs


def public(inst):
    """What the screens see of an install (no paths)."""
    return {
        "id": inst["id"], "disk": inst.get("disk"), "hostname": inst["hostname"],
        "versions": [{"index": d["index"], "version": d["version"], "image": d["image"], "kept": d.get("pinned", False)} for d in inst["deployments"]],
        "users": [{"name": u["name"], "admin": u["admin"]} for u in inst["users"]],
    }


def find(install_id):
    if not ID_RE.match(install_id or ""):
        return None
    for inst in probe():
        if inst["id"] == install_id:
            return inst
    return None


# ---------------------------------------------------------------- what's wrong
def tessera_paths(user_home):
    data = os.path.join(user_home, ".local", "share", "tessera")
    state = os.path.join(user_home, ".local", "state", "tessera")
    return {"settings": os.path.join(data, "settings.json"), "state": state, "vault": os.path.join(user_home, "Tessera")}


def signin_state(inst):
    etc = inst["etc"]
    wants = os.path.join(etc, "systemd", "system", "multi-user.target.wants", "tessera-autologin.service")
    return {"enabled": os.path.lexists(wants), "turned_off": os.path.exists(os.path.join(etc, "tessera", "no-autologin"))}


def journal_dir(inst):
    subs = []
    for var in var_roots(inst["mount"], inst["sysroot"], inst["stateroot"]):
        base = os.path.join(var, "log", "journal")
        try:
            subs += [os.path.join(base, s) for s in os.listdir(base) if os.path.isdir(os.path.join(base, s))]
        except OSError:
            pass
    return max(subs, key=os.path.getmtime) if subs else None


def last_start(inst):
    """Errors from the last start the install recorded."""
    j = journal_dir(inst)
    if not j or not shutil.which("journalctl"):
        return {"recorded": False}
    base = ["journalctl", "-D", j, "-b", "--no-pager", "-q", "-o", "short-monotonic"]
    errors = run(base + ["-p", "0..3", "-n", "60"], timeout=60).stdout
    failed = run(base + ["-g", "Failed to start|failed with result|Failed with result", "-n", "30"], timeout=60).stdout
    when = run(["journalctl", "-D", j, "--list-boots", "--no-pager", "-q"], timeout=60).stdout.strip().splitlines()
    return {"recorded": True, "errors": errors[-6000:], "failed": failed[-4000:], "boot": when[-1][:160] if when else ""}


def space(path):
    try:
        s = os.statvfs(path)
        return {"free": s.f_bavail * s.f_frsize, "total": s.f_blocks * s.f_frsize}
    except OSError:
        return None


def health(inst):
    out = {}
    fs = inst.get("fs") or {}
    if fs.get("type") == "btrfs" and shutil.which("btrfs"):
        r = run(["btrfs", "device", "stats", inst["mount"]], timeout=30)
        errs = {}
        for line in r.stdout.splitlines():
            m = re.match(r"\[(.+)\]\.(\w+)\s+(\d+)", line.strip())
            if m and int(m.group(3)):
                errs[m.group(2)] = errs.get(m.group(2), 0) + int(m.group(3))
        out["filesystem_errors"] = errs
    disk = (inst.get("disk") or {}).get("name")
    if disk and shutil.which("smartctl"):
        r = run(["smartctl", "-H", "-j", f"/dev/{disk}"], timeout=30)
        try:
            j = json.loads(r.stdout)
            out["disk_ok"] = bool(j.get("smart_status", {}).get("passed")) if "smart_status" in j else None
        except ValueError:
            out["disk_ok"] = None
    return out


def diagnose(inst):
    findings = []
    si = signin_state(inst)
    if not si["enabled"]:
        findings.append({"key": "signin", "text": "Tessera isn't set to start at boot (its automatic sign-in is off). That shows a login screen or a text screen instead.", "fix": "signin"})
    elif si["turned_off"]:
        findings.append({"key": "signin", "text": "Starting in Tessera at boot was turned off on purpose (/etc/tessera/no-autologin).", "fix": "signin"})
    sp = space(inst["mount"])
    if sp and sp["total"] and sp["free"] < max(2 << 30, sp["total"] // 50):
        findings.append({"key": "space", "text": f"The disk is nearly full ({sp['free'] // (1 << 20)} MB free). A full disk can stop Tessera from starting.", "fix": "clean"})
    h = health(inst)
    if h.get("filesystem_errors"):
        findings.append({"key": "fs", "text": "The file system has recorded errors: " + ", ".join(f"{k} {v}" for k, v in h["filesystem_errors"].items()) + ".", "fix": None})
    if h.get("disk_ok") is False:
        findings.append({"key": "disk", "text": "The disk itself reports it is failing. Back up what matters as soon as you can.", "fix": None})
    shards_on = []
    for u in inst["users"]:
        if not u.get("path"):
            continue
        s = load_json(tessera_paths(u["path"])["settings"])
        on = ((s or {}).get("codeAddons") or {}).get("enabled") or []
        if on:
            shards_on.append(f"{u['name']}: {len(on)}")
    if shards_on:
        findings.append({"key": "shards", "text": "Shards are turned on (" + "; ".join(shards_on) + "). If one breaks start-up, turning them all off helps.", "fix": "shards"})
    if len(inst["deployments"]) > 1:
        findings.append({"key": "versions", "text": f"An earlier version ({inst['deployments'][1]['version'] or 'previous'}) is kept: Boot options can start it.", "fix": None})
    return {"signin": si, "space": sp, "health": h, "last_start": last_start(inst), "findings": findings}


# ---------------------------------------------------------------- report
def scrub(text, inst):
    t = text
    for u in inst["users"]:
        if len(u["name"]) > 1:
            t = re.sub(rf"\b{re.escape(u['name'])}\b", "[user]", t, flags=re.I)
    if inst["hostname"] and inst["hostname"] not in ("tessera", "localhost"):
        t = re.sub(rf"\b{re.escape(inst['hostname'])}\b", "[computer]", t, flags=re.I)
    t = re.sub(r"[\w.+-]+@[\w-]+(\.[\w-]+)+", "[e-mail]", t)
    t = re.sub(r"\b([0-9a-f]{2}[:-]){5}[0-9a-f]{2}\b", "[hardware address]", t, flags=re.I)
    t = re.sub(r"\b(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)\b", lambda m: m.group(0) if m.group(0) in ("127.0.0.1", "0.0.0.0") else "[ip]", t)
    return t


def report_text(inst, diag):
    lines = [f"Tessera recovery report, made {datetime.datetime.now().isoformat(timespec='seconds')} from the Tessera USB.",
             "Made on this machine when asked. Nothing in it was sent anywhere.", ""]
    lines.append("== Versions (newest first)")
    lines += [f"{d['index']}: {d['version'] or '?'}  {d['image']}" for d in inst["deployments"]]
    lines += ["", "== What was found"] + [f"- {f['text']}" for f in diag["findings"]] + (["- Nothing obviously wrong."] if not diag["findings"] else [])
    sp = diag["space"]
    lines += ["", "== Disk", f"free {sp['free'] // (1 << 20)} MB of {sp['total'] // (1 << 20)} MB" if sp else "space unknown", f"health: {json.dumps(diag['health'])}"]
    ls = diag["last_start"]
    lines += ["", "== The last start", ls.get("boot", "") if ls.get("recorded") else "no system log recorded"]
    if ls.get("recorded"):
        lines += ["-- errors", ls["errors"].strip() or "(none)", "-- failed", ls["failed"].strip() or "(none)"]
    return scrub("\n".join(lines) + "\n", inst)


def save_report(inst, text):
    """Into the first person's Tessera/Reports folder, owned by them."""
    for u in inst["users"]:
        if not u.get("path") or not os.path.isdir(u["path"]):
            continue
        with writable(inst):
            folder = os.path.join(tessera_paths(u["path"])["vault"], "Reports")
            os.makedirs(folder, exist_ok=True)
            os.chown(folder, u["uid"], u["gid"])
            name = f"tessera-recovery-report-{datetime.datetime.now().strftime('%Y%m%d-%H%M%S')}.txt"
            p = os.path.join(folder, name)
            with open(p, "w") as f:
                f.write(text)
            os.chown(p, u["uid"], u["gid"])
            os.chmod(p, 0o644)
        return f"~/Tessera/Reports/{name} ({u['name']})"
    return None


# ---------------------------------------------------------------- repairs
class writable:
    """Mounts the install's file system read-write for one repair, and back to read-only after."""

    def __init__(self, inst):
        self.inst = inst

    def __enter__(self):
        if os.environ.get("TESSERA_RECOVER_MNT"):
            return self  # tests: plain folders
        r = run(["mount", "-o", "remount,rw", self.inst["mount"]])
        if r.returncode != 0:
            raise RuntimeError("The disk couldn't be opened for changes: " + (r.stderr.strip() or "mount failed"))
        return self

    def __exit__(self, *exc):
        if not os.environ.get("TESSERA_RECOVER_MNT"):
            run(["sync"])
            run(["mount", "-o", "remount,ro", self.inst["mount"]])
        return False


def libcrypt():
    name = os.environ.get("TESSERA_LIBCRYPT") or ctypes.util.find_library("crypt") or "libcrypt.so.2"
    lib = ctypes.CDLL(name)
    lib.crypt.restype = ctypes.c_char_p
    lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    return lib


def password_ok(inst, user, password):
    """The password of an administrator (wheel) of the install, checked against its own /etc/shadow."""
    if not isinstance(user, str) or not USER_RE.match(user) or not isinstance(password, str) or not password:
        return False
    if user not in [u["name"] for u in inst["users"] if u["admin"]]:
        return False
    for line in (read(os.path.join(inst["etc"], "shadow")) or "").splitlines():
        p = line.split(":")
        if len(p) > 1 and p[0] == user:
            stored = p[1]
            if not stored.startswith("$"):
                return False  # locked or no password
            got = libcrypt().crypt(password.encode(), stored.encode())
            return bool(got) and hmac.compare_digest(got.decode(), stored)
    return False


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_json_as_owner(path, data):
    """Rewrite a person's file keeping its owner and permissions."""
    st = os.stat(path)
    tmp = path + ".tessera-recover"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, path)


def fix_signin(inst):
    done = []
    unit = "/usr/lib/systemd/system/tessera-autologin.service"
    with writable(inst):
        for d in inst["deployments"]:
            etc = os.path.join(d["dir"], "etc")
            wants = os.path.join(etc, "systemd", "system", "multi-user.target.wants")
            os.makedirs(wants, exist_ok=True)
            link = os.path.join(wants, "tessera-autologin.service")
            if not os.path.lexists(link):
                os.symlink(unit, link)
                done.append(f"turned on for version {d['version'] or d['index']}")
            off = os.path.join(etc, "tessera", "no-autologin")
            if os.path.exists(off):
                os.remove(off)
                done.append(f"removed /etc/tessera/no-autologin from version {d['version'] or d['index']}")
    return done or ["It was already on."]


def fix_settings(inst, change):
    done = []
    with writable(inst):
        for u in inst["users"]:
            if not u.get("path"):
                continue
            paths = tessera_paths(u["path"])
            s = load_json(paths["settings"])
            if s is None:
                continue
            said = change(s, paths)
            if said:
                save_json_as_owner(paths["settings"], s)
                done.append(f"{u['name']}: {said}")
    return done


def fix_pin(inst):
    def change(s, paths):
        had = s.pop("pin", None) is not None
        tries = os.path.join(paths["state"], "pin-tries.json")
        if os.path.exists(tries):
            os.remove(tries)
        return "the admin PIN was removed" if had else None
    return fix_settings(inst, change) or ["No admin PIN was set."]


def fix_shards(inst):
    def change(s, _paths):
        ca = s.get("codeAddons")
        if isinstance(ca, dict) and ca.get("enabled"):
            n = len(ca["enabled"])
            ca["enabled"] = []
            return f"{n} shard{'s' if n != 1 else ''} turned off"
        return None
    return fix_settings(inst, change) or ["No shards were on."]


class boot_mounted:
    """The install's boot partition at <sysroot>/boot, writable, while ostree changes its boot entries."""

    def __init__(self, inst):
        self.inst = inst
        self.target = os.path.join(inst["sysroot"], "boot")

    def __enter__(self):
        b = self.inst.get("boot")
        if not b:
            raise RuntimeError("The boot partition of that Tessera wasn't found.")
        if os.environ.get("TESSERA_RECOVER_MNT"):
            return self  # tests: plain folders
        release(b["device"])
        r = run(["mount", "-o", "rw", b["device"], self.target])
        if r.returncode != 0:
            run(["mount", "-o", "ro", b["device"], b["path"]])
            raise RuntimeError("The boot partition couldn't be opened: " + (r.stderr.strip() or "mount failed"))
        return self

    def __exit__(self, *exc):
        if not os.environ.get("TESSERA_RECOVER_MNT"):
            b = self.inst["boot"]
            run(["sync"])
            run(["umount", self.target])
            run(["mount", "-o", "ro", b["device"], b["path"]])
        return False


def bootloader_setting(inst):
    """ostree's bootloader setting for the install: anything but 'none' would make it rewrite GRUB's
    config with the USB's settings, so version changes are refused then."""
    m = re.search(r"^\s*bootloader\s*=\s*(\S+)", read(os.path.join(inst["sysroot"], "ostree", "repo", "config")) or "", re.M)
    return m.group(1) if m else "auto"


def fix_version(inst, req):
    action, index = req.get("action"), req.get("index")
    if action not in VERSION_ACTIONS or not isinstance(index, int) or isinstance(index, bool):
        raise RuntimeError("Unknown change.")
    d = next((x for x in inst["deployments"] if x["index"] == index), None)
    if not d:
        raise RuntimeError("That version isn't there any more.")
    if action == "default" and bootloader_setting(inst) not in ("none",) and not os.path.isfile(os.path.join(inst["boot"]["path"] if inst.get("boot") else "", "grub2", "bootuuid.cfg")):
        raise RuntimeError("This Tessera's boot menu is set up in a way Recover can't change safely from the USB.")
    args = {"default": ["set-default", str(index)], "keep": ["pin", str(index)], "unkeep": ["pin", "--unpin", str(index)]}[action]
    with writable(inst), boot_mounted(inst):
        r = run([OSTREE, "admin", f"--sysroot={inst['sysroot']}"] + args, timeout=600)
    if r.returncode != 0:
        raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else "ostree failed")
    name = d["version"] or f"version {index}"
    return [{"default": f"{name} now starts by default", "keep": f"{name} is kept for good (updates won't remove it)", "unkeep": f"{name} is no longer kept for good"}[action]]


# ---------------------------------------------------------------- free up space
# What can be cleared safely: all of it comes back by itself (caches, shaders) or was thrown away.
CLEAR = {
    "caches": [".cache", ".var/app/com.valvesoftware.Steam/cache", ".var/app/com.heroicgameslauncher.hgl/cache"],
    "shaders": [".local/share/Steam/steamapps/shadercache", ".var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/shadercache"],
    "trash": [".local/share/Trash"],
}
GAMES = [".local/share/Steam/steamapps/common", ".var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common", "Games"]


def tree_size(path):
    """Bytes in a folder, never following links; 0 when it isn't there."""
    if os.path.islink(path) or not os.path.isdir(path):
        return 0
    total = 0
    for root, dirs, files in os.walk(path, followlinks=False):
        for n in files:
            try:
                st = os.lstat(os.path.join(root, n))
                total += st.st_blocks * 512 if hasattr(st, "st_blocks") else st.st_size
            except OSError:
                pass
    return total


def space_use(inst):
    sp = space(inst["mount"]) or {"free": 0, "total": 0}
    people = []
    for u in inst["users"]:
        if not u.get("path"):
            continue
        row = {"name": u["name"], "home": tree_size(u["path"])}
        for k, rels in CLEAR.items():
            row[k] = sum(tree_size(os.path.join(u["path"], r)) for r in rels)
        row["games"] = sum(tree_size(os.path.join(u["path"], r)) for r in GAMES)
        people.append(row)
    return {"free": sp["free"], "total": sp["total"], "people": people, "versions": len(inst["deployments"])}


def empty_folder(path):
    """Removes what is inside a folder (not the folder itself); never follows links out of it."""
    if os.path.islink(path) or not os.path.isdir(path):
        return 0
    freed = tree_size(path)
    for n in os.listdir(path):
        p = os.path.join(path, n)
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p, ignore_errors=True)
        else:
            try:
                os.remove(p)
            except OSError:
                pass
    return freed - tree_size(path)


def fix_clean(inst, req):
    what = [w for w in (req.get("what") or []) if w in CLEAR]
    if not what:
        raise RuntimeError("Nothing was chosen.")
    done = []
    with writable(inst):
        for u in inst["users"]:
            if not u.get("path"):
                continue
            freed = sum(empty_folder(os.path.join(u["path"], r)) for w in what for r in CLEAR[w])
            if freed:
                done.append(f"{u['name']}: {freed / 1e9:.1f} GB freed" if freed >= 1e8 else f"{u['name']}: {freed // 1_000_000} MB freed")
    return done or ["There was nothing to clear."]


FIXES = {"signin": fix_signin, "pin": fix_pin, "shards": fix_shards, "version": fix_version, "clean": fix_clean}


# ---------------------------------------------------------------- back up to a USB drive
USB_FS = ("vfat", "exfat", "ntfs", "ext4", "btrfs", "xfs")
FAT_LIKE = ("vfat", "exfat", "ntfs")  # no links, no owners; FAT also no file over 4 GB
# Things that can be downloaded again, left out of "my files"
SKIP_MINE = [
    ".cache", ".local/share/Trash",
    ".local/share/Steam/steamapps/common", ".local/share/Steam/steamapps/shadercache", ".local/share/Steam/steamapps/downloading",
    ".steam/steam/steamapps/common", ".steam/steam/steamapps/shadercache",
    ".var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common", ".var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/shadercache",
    ".var/app/com.valvesoftware.Steam/cache", ".var/app/com.heroicgameslauncher.hgl/cache",
]
SKIP_ALL = [".cache", ".local/share/Trash"]


def state_file():
    return os.path.join(MNT, "backup.json")


def drives(installs=None):
    """Removable drives with a file system a backup can go on: never this USB, never a disk with a
    Tessera on it (an install on an external drive). Looked at read-only; only the drive a backup
    goes to is made writable, when it starts."""
    if installs is None:
        installs = probe()
    devs = list(flat(lsblk().get("blockdevices")))
    skip = {live_disk()} | {(i.get("disk") or {}).get("name") for i in installs}
    skip.discard(None)
    out = []
    for d, parent in devs:
        disk = d.get("pkname") or (parent or {}).get("name") or d.get("name")
        top = next((x for x, _ in devs if x.get("name") == disk), parent or d)
        removable = bool(top.get("rm")) or (top.get("tran") or "") == "usb"
        if not removable or disk in skip or d.get("fstype") not in USB_FS or not d.get("uuid"):
            continue
        where = os.path.join(MNT, "usb-" + d["uuid"])
        if not mount_usb(d["path"], d["fstype"], where):
            continue
        sp = space(where) or {}
        out.append({"uuid": d["uuid"], "device": d["path"], "fstype": d["fstype"], "label": d.get("label") or "", "model": (top.get("model") or "").strip(),
                    "size": int(d.get("size") or 0), "free": sp.get("free", 0), "path": where})
    return out


def mount_usb(dev, fstype, where, rw=False):
    os.makedirs(where, exist_ok=True)
    if os.environ.get("TESSERA_RECOVER_MNT"):
        return True  # tests
    if os.path.ismount(where):
        return run(["mount", "-o", "remount," + ("rw" if rw else "ro"), where]).returncode == 0 if rw else True
    args = ["mount", "-o", ("rw" if rw else "ro") + ",noatime"] + (["-t", "ntfs3"] if fstype == "ntfs" else []) + [dev, where]
    return run(args).returncode == 0


def plan(src, skip):
    """[(relative path, size, kind)] of everything to copy, and the total size."""
    skip = {os.path.normpath(s) for s in skip}
    items, total = [], 0
    for root, dirs, files in os.walk(src, followlinks=False):
        rel_root = os.path.relpath(root, src)
        dirs[:] = sorted(d for d in dirs if os.path.normpath(os.path.join(rel_root, d)) not in skip)
        for name in sorted(files) + [d for d in dirs if os.path.islink(os.path.join(root, d))]:
            p = os.path.join(root, name)
            rel = os.path.normpath(os.path.join(rel_root, name))
            if rel in skip:
                continue
            if os.path.islink(p):
                items.append((rel, 0, "link"))
            elif os.path.isfile(p):
                size = os.path.getsize(p)
                items.append((rel, size, "file"))
                total += size
        items.append((os.path.normpath(rel_root), 0, "dir"))
    return items, total


def copy_tree(src, dest, skip, fstype, progress=lambda done, total, name: None, stop=lambda: False):
    """Copy src into dest; returns {copied, bytes, skipped: [(path, why)]}."""
    items, total = plan(src, skip)
    fat = fstype in FAT_LIKE
    done, copied, skipped = 0, 0, []
    os.makedirs(dest, exist_ok=True)
    for rel, size, kind in sorted(items, key=lambda x: (x[2] != "dir", x[0])):
        if stop():
            raise RuntimeError("Stopped.")
        target = os.path.join(dest, rel)
        source = os.path.join(src, rel)
        try:
            if kind == "dir":
                os.makedirs(target, exist_ok=True)
                continue
            if kind == "link":
                if fat:
                    skipped.append((rel, "a link (this drive can't hold links)"))
                else:
                    if os.path.lexists(target):
                        os.remove(target)
                    os.symlink(os.readlink(source), target)
                continue
            if fstype == "vfat" and size >= 4 << 30:
                skipped.append((rel, "over 4 GB (this drive's FAT format can't hold it)"))
                continue
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with open(source, "rb") as fi, open(target, "wb") as fo:
                while True:
                    chunk = fi.read(8 << 20)
                    if not chunk:
                        break
                    fo.write(chunk)
                    done += len(chunk)
                    progress(done, total, rel)
                    if stop():
                        raise RuntimeError("Stopped.")
            st = os.stat(source)
            os.utime(target, (st.st_atime, st.st_mtime))
            if not fat:
                os.chmod(target, st.st_mode & 0o7777)
                try:
                    os.chown(target, st.st_uid, st.st_gid)
                except OSError:
                    pass
            copied += 1
        except RuntimeError:
            raise
        except OSError as e:
            skipped.append((rel, e.strerror or str(e)))
    return {"copied": copied, "bytes": done, "total": total, "skipped": skipped}


def write_state(**kw):
    os.makedirs(MNT, exist_ok=True)
    tmp = state_file() + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"at": datetime.datetime.now().timestamp(), **kw}, f)
    os.chmod(tmp, 0o644)
    os.replace(tmp, state_file())


def backup_job(inst, who, drive, what):
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H%M")
    dest = os.path.join(drive["path"], f"Tessera backup {stamp}", who["name"])
    stopfile = os.path.join(MNT, "backup.stop")
    if os.path.exists(stopfile):
        os.remove(stopfile)
    last = [0.0]

    def progress(done, total, name):
        now = datetime.datetime.now().timestamp()
        if now - last[0] > 0.5:
            last[0] = now
            write_state(phase="copying", done=done, total=total, line=name[-120:], pid=os.getpid())

    write_state(phase="copying", done=0, total=0, line="Counting what to copy…", pid=os.getpid())
    try:
        r = copy_tree(who["path"], dest, SKIP_MINE if what == "mine" else SKIP_ALL, drive["fstype"], progress, lambda: os.path.exists(stopfile))
        run(["sync"])
        listing = "\n".join(f"{p}: {why}" for p, why in r["skipped"])
        if r["skipped"]:
            with open(os.path.join(dest, "..", "not copied.txt"), "w") as f:
                f.write(listing + "\n")
        if not os.environ.get("TESSERA_RECOVER_MNT"):
            run(["umount", drive["path"]])  # safe to unplug
        write_state(phase="done", done=r["bytes"], total=r["total"], copied=r["copied"], skipped=len(r["skipped"]),
                    folder=os.path.basename(os.path.dirname(dest)), drive=drive.get("label") or drive.get("model") or "the USB drive")
    except (OSError, RuntimeError) as e:
        if not os.environ.get("TESSERA_RECOVER_MNT"):
            run(["sync"])
            run(["umount", drive["path"]])
        write_state(phase="error" if str(e) != "Stopped." else "canceled", error=str(e))


def start_backup(inst, req):
    who = next((u for u in inst["users"] if u["name"] == req.get("who") and u.get("path")), None)
    if not who:
        return {"ok": False, "error": "That person's home folder wasn't found."}
    drive = next((d for d in drives(probe() if not os.environ.get("TESSERA_RECOVER_MNT") else [inst]) if d["uuid"] == req.get("drive")), None)
    if not drive:
        return {"ok": False, "error": "That USB drive isn't there any more."}
    if not mount_usb(drive["device"], drive["fstype"], drive["path"], rw=True):
        return {"ok": False, "error": "That USB drive can't be written to (is it locked, or full of errors?)."}
    if req.get("what") not in ("mine", "all"):
        return {"ok": False, "error": "Unknown choice."}
    st = load_json(state_file()) or {}
    if st.get("phase") == "copying" and st.get("pid") and os.path.exists(f"/proc/{st['pid']}"):
        return {"ok": False, "error": "A backup is already running."}
    if os.environ.get("TESSERA_RECOVER_FOREGROUND"):
        backup_job(inst, who, drive, req["what"])
        return {"ok": True, "started": True}
    pid = os.fork()
    if pid:
        return {"ok": True, "started": True}
    os.setsid()
    with open(os.devnull, "rb") as dn_in, open(os.devnull, "wb") as dn_out:
        os.dup2(dn_in.fileno(), 0)
        os.dup2(dn_out.fileno(), 1)
        os.dup2(dn_out.fileno(), 2)
    try:
        backup_job(inst, who, drive, req["what"])
    finally:
        os._exit(0)


# ---------------------------------------------------------------- command line
def out(obj):
    print(json.dumps(obj))
    return 0 if obj.get("ok") else 1


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd = argv[0]
    if cmd == "probe":
        return out({"ok": True, "installs": [public(i) for i in probe()]})
    if cmd == "drives":
        return out({"ok": True, "drives": [{k: v for k, v in d.items() if k != "path"} for d in drives()]})
    if cmd == "state":
        return out({"ok": True, **(load_json(state_file()) or {"phase": "idle"})})
    if cmd == "cancel":
        open(os.path.join(MNT, "backup.stop"), "w").close()
        return out({"ok": True})
    if cmd in ("diagnose", "report", "fix", "backup", "space"):
        inst = find(argv[1] if len(argv) > 1 else "")
        if not inst:
            return out({"ok": False, "error": "That Tessera install isn't there any more."})
        if cmd == "space":
            return out({"ok": True, **space_use(inst)})
        if cmd == "diagnose":
            d = diagnose(inst)
            return out({"ok": True, "install": public(inst), "findings": d["findings"], "signin": d["signin"], "space": d["space"], "health": d["health"],
                        "lastStart": {k: v for k, v in d["last_start"].items() if k in ("recorded", "boot")}})
        if cmd == "report":
            text = report_text(inst, diagnose(inst))
            try:
                saved = save_report(inst, text)
            except (OSError, RuntimeError) as e:
                saved = None
                text += f"\n(Couldn't save it on the disk: {e})\n"
            return out({"ok": True, "text": text, "saved": saved})
        try:
            req = json.loads(sys.stdin.read(65536) or "{}")
        except ValueError:
            req = {}
        if cmd == "backup":
            if not password_ok(inst, req.get("user"), req.get("password")):
                return out({"ok": False, "error": "That isn't the password of an administrator account on this Tessera.", "needPassword": True})
            return out(start_backup(inst, req))
        tool = req.get("tool")
        if tool not in TOOLS:
            return out({"ok": False, "error": "Unknown repair."})
        if not password_ok(inst, req.get("user"), req.get("password")):
            return out({"ok": False, "error": "That isn't the password of an administrator account on this Tessera.", "needPassword": True})
        try:
            return out({"ok": True, "done": FIXES[tool](inst, req) if tool in ("version", "clean") else FIXES[tool](inst)})
        except (OSError, RuntimeError) as e:
            return out({"ok": False, "error": f"The repair didn't finish: {e}"})
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
